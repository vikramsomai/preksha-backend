ADMIN_PASSWORD=admin123

# For production, generate a bcrypt hash:
# Run: node -e "console.log(require('bcrypt').hashSync('your_password', 10))"
# ADMIN_PASSWORD_HASH=$2b$10$your_hashed_password_here

