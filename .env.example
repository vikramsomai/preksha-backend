# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/preksha_fashion

# JWT Secrets (generate strong random strings for production)
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
SECRET_KEY=your_admin_secret_key_change_this_in_production

# Client URL for CORS (comma-separated for multiple origins)
